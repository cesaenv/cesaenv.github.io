---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { projectPath, useTranslations, type Lang } from '../i18n/ui';
import { slugOf } from '../lib/projects';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  eager?: boolean;
  headingLevel?: 2 | 3;
}

const { project, lang, eager = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const t = useTranslations(lang);
const { title, summary, stack, repo, demo, image, imageAlt } = project.data;
const href = projectPath(lang, slugOf(project));
---

<article class="project" data-testid="project-card">
  {
    image && (
      <a href={href} class="media" tabindex="-1" aria-hidden="true">
        <Image
          src={image}
          alt={imageAlt ?? ''}
          widths={[400, 640, 960]}
          sizes="(min-width: 46rem) 22rem, 100vw"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
        />
      </a>
    )
  }
  <div class="body">
    <Heading class="title"><a href={href}>{title}</a></Heading>
    <p class="summary">{summary}</p>
    <p class="stack">
      <span class="sr-only">{t('projects.stack')}: </span>{stack.join(' · ')}
    </p>
    <p class="actions">
      {repo && <a href={repo}>{t('projects.repo')}</a>}
      {demo && <a href={demo}>{t('projects.demo')}</a>}
      <a href={href}>{t('projects.details')}</a>
    </p>
  </div>
</article>

<style>
  .project {
    display: grid;
    gap: 1.25rem;
  }

  .media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .title {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.4rem;
  }

  .title a {
    color: var(--text);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--accent);
  }

  .summary {
    margin-bottom: 0.6rem;
    color: var(--muted);
  }

  .stack {
    color: var(--text);
    font-size: 0.875rem;
    margin-bottom: 0.8rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 550;
  }

  @media (min-width: 46rem) {
    .project {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: 2rem;
      align-items: start;
    }
  }
</style>
