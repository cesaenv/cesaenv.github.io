---
import Icon from './Icon.astro';
import { site, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<ul class="links" aria-label={t('links.label')}>
  <li><a href={site.linkedin} data-testid="link-linkedin"><Icon name="linkedin" size={18} />LinkedIn</a></li>
  <li><a href={site.github} data-testid="link-github"><Icon name="github" size={18} />GitHub</a></li>
  <li><a href={`mailto:${site.email}`} data-testid="link-email"><Icon name="email" size={18} />Email</a></li>
</ul>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-weight: 550;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0;
  }
</style>
