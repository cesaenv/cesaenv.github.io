---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button type="button" class="theme" data-theme-toggle aria-label={label} title={label}>
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
    <path
      d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"></path>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path
      d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  // El tema por defecto es el oscuro; solo cambia si se elige el claro.
  function isDark() {
    return root.dataset.theme !== 'light';
  }

  function sync() {
    button?.setAttribute('aria-pressed', String(isDark()));
  }

  button?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Sin almacenamiento (modo privado): el cambio dura hasta recargar.
    }
    sync();
  });

  sync();
</script>

<style>
  .theme {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .theme:hover {
    color: var(--accent);
  }

  .sun {
    display: none;
  }

  :global(:root[data-theme='light']) .sun {
    display: block;
  }

  :global(:root[data-theme='light']) .moon {
    display: none;
  }
</style>
