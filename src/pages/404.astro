---
import Base from '../layouts/Base.astro';
import { routes } from '../i18n/ui';
---

<Base lang="es" title="Página no encontrada" description="Esta página no existe." alternates={{ es: routes.home.es, en: routes.home.en }}>
  <section class="container section">
    <h1>Página no encontrada</h1>
    <p>Esta página no existe o ha cambiado de sitio. <a href={routes.home.es}>Volver al inicio</a>.</p>
    <p lang="en">This page doesn't exist or has moved. <a href={routes.home.en}>Go to the home page</a>.</p>
  </section>
</Base>
