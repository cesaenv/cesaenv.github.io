---
import Project from '../../../views/Project.astro';
import { getProjects, slugOf } from '../../../lib/projects';

export async function getStaticPaths() {
  const others = new Set((await getProjects('en')).map(slugOf));
  return (await getProjects('es')).map((project) => ({
    params: { slug: slugOf(project) },
    props: { project, hasTranslation: others.has(slugOf(project)) },
  }));
}

const { project, hasTranslation } = Astro.props;
---

<Project lang="es" project={project} hasTranslation={hasTranslation} />
